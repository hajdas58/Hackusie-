function loseOneHeart(reasonText, loc) {
  gameState.lives -= 1;
  playTone(150, 0.35, 'sawtooth');
  updateTopAndBottomHud();

  if (gameState.lives <= 0) {
    closeInteriorModal();
    showEndGameModal(false);
