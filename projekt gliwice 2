<!DOCTYPE html>
<html lang="pl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>GLIWICE: KRONIKI ZSTI — Miejska Gra Przygodowa</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&family=Press+Start+2P&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<style>
:root {
  --ui-bg: rgba(17, 24, 39, 0.96);
  --ui-surface: #1f2937;
  --ui-border: #374151;
  --ui-accent: #3b82f6;
  --ui-success: #10b981;
  --ui-danger: #ef4444;
  --ui-text: #f9fafb;
  --ui-muted: #9ca3af;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  user-select: none;
  -webkit-user-select: none;
}

body, html {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background-color: #0b0f17;
  font-family: 'Inter', sans-serif;
  color: var(--ui-text);
}

#game-wrapper {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

#map {
  width: 100%;
  height: 100%;
  z-index: 1;
  background: #0d131a;
}

.leaflet-tile-pane {
  filter: contrast(1.04) saturate(1.05);
}

.leaflet-control-attribution {
  font-size: 9px !important;
  background: rgba(17, 24, 39, 0.88) !important;
  color: #9ca3af !important;
}
.leaflet-control-attribution a { color: #60a5fa !important; }

/* GÓRNY PASEK HUD (CZYSTY STYL TECHNICZNY) */
.top-hud {
  position: absolute;
  top: 12px;
  left: 12px;
  right: 12px;
  z-index: 500;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  pointer-events: none;
}

.hud-panel {
  pointer-events: auto;
  background: var(--ui-bg);
  border: 1px solid var(--ui-border);
  border-radius: 8px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
}

.player-card {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 8px 14px;
}

.player-avatar {
  width: 44px;
  height: 48px;
  background: #111827;
  border: 1px solid var(--ui-border);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.player-info {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.player-title {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  font-weight: 700;
  color: #93c5fd;
}

.hearts-row {
  display: flex;
  gap: 4px;
  align-items: center;
}

.heart-svg {
  width: 18px;
  height: 18px;
  transition: transform 0.2s, opacity 0.2s;
}
.heart-svg.lost {
  opacity: 0.18;
  filter: grayscale(1);
}

.player-stats {
  display: flex;
  gap: 12px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--ui-muted);
}
.player-stats b { color: #fff; }

.story-tracker {
  padding: 9px 16px;
  max-width: 540px;
  text-align: left;
  border-left: 3px solid var(--ui-accent);
}

.story-chapter-tag {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 700;
  color: #60a5fa;
  text-transform: uppercase;
  margin-bottom: 2px;
}

.story-objective {
  font-size: 13px;
  font-weight: 700;
  color: #ffffff;
}

.story-sub {
  font-size: 11px;
  color: var(--ui-muted);
  margin-top: 2px;
}

.hud-actions {
  display: flex;
  gap: 8px;
}

.hud-btn {
  pointer-events: auto;
  background: var(--ui-bg);
  color: var(--ui-text);
  border: 1px solid var(--ui-border);
  border-radius: 6px;
  padding: 9px 13px;
  font-family: 'Inter', sans-serif;
  font-weight: 600;
  font-size: 12px;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: background 0.15s, border-color 0.15s;
}
.hud-btn:hover {
  background: var(--ui-surface);
  border-color: #60a5fa;
}
.hud-btn.bus-btn {
  background: #1d4ed8;
  border-color: #3b82f6;
  color: #fff;
}
.hud-btn.bus-btn:hover {
  background: #1e40af;
}

/* DOLNY PASEK NAWIGACJI */
.bottom-hud {
  position: absolute;
  bottom: 14px;
  left: 14px;
  right: 14px;
  z-index: 500;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  pointer-events: none;
}

.dpad-box {
  pointer-events: auto;
  background: var(--ui-bg);
  border: 1px solid var(--ui-border);
  border-radius: 8px;
  padding: 8px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
}

.dpad-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  color: var(--ui-muted);
  text-transform: uppercase;
}

.dpad-grid {
  display: grid;
  grid-template-columns: repeat(3, 36px);
  grid-template-rows: repeat(3, 36px);
  gap: 3px;
}

.dpad-btn {
  background: var(--ui-surface);
  border: 1px solid #4b5563;
  border-radius: 6px;
  color: #fff;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dpad-btn:active, .dpad-btn.active {
  background: var(--ui-accent);
  border-color: #fff;
}
.dpad-up { grid-column: 2; grid-row: 1; }
.dpad-left { grid-column: 1; grid-row: 2; }
.dpad-center {
  grid-column: 2; grid-row: 2;
  background: #111827;
  border-radius: 4px;
  border: 1px solid #374151;
}
.dpad-right { grid-column: 3; grid-row: 2; }
.dpad-down { grid-column: 2; grid-row: 3; }

.location-dock {
  pointer-events: auto;
  background: var(--ui-bg);
  border: 1px solid var(--ui-border);
  border-left: 4px solid var(--ui-accent);
  border-radius: 8px;
  padding: 12px 16px;
  max-width: 580px;
  width: 100%;
  margin: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-shadow: 0 8px 24px rgba(0,0,0,0.6);
}

.loc-dock-info h3 {
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 2px;
}

.loc-dock-info p {
  font-size: 12px;
  color: var(--ui-muted);
}

.action-primary-btn {
  background: #2563eb;
  color: #ffffff;
  border: 1px solid #60a5fa;
  border-radius: 6px;
  padding: 10px 16px;
  font-family: 'Inter', sans-serif;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  transition: background 0.15s;
  white-space: nowrap;
}
.action-primary-btn:hover {
  background: #1d4ed8;
}
.action-primary-btn.enter-ready {
  background: #059669;
  border-color: #34d399;
}
.action-primary-btn.enter-ready:hover {
  background: #047857;
}

/* POSTAĆ GRACZA NA CHODNIKU */
.hero-map-marker {
  width: 30px;
  height: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
  filter: drop-shadow(0 3px 4px rgba(0,0,0,0.85));
}

.hero-you-badge {
  background: #2563eb;
  color: #fff;
  font-family: 'JetBrains Mono', monospace;
  font-weight: 800;
  font-size: 8px;
  padding: 1px 4px;
  border-radius: 3px;
  border: 1px solid #000;
}

.hero-sprite-small {
  width: 24px;
  height: 30px;
}

.hero-walking .hero-sprite-small {
  animation: walkBobSmall 0.22s infinite alternate;
}

@keyframes walkBobSmall {
  0% { transform: translateY(0) rotate(-4deg); }
  100% { transform: translateY(-3px) rotate(4deg); }
}

/* ZNACZNIKI MISJI I ZABYTKÓW */
.loc-pin-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  transition: transform 0.15s;
}
.loc-pin-wrap:hover { transform: scale(1.08) translateY(-2px); }

.loc-pin-badge {
  background: #111827;
  border: 1px solid #4b5563;
  color: #e5e7eb;
  padding: 2px 7px;
  border-radius: 4px;
  font-size: 10px;
  font-weight: 600;
  white-space: nowrap;
  margin-bottom: 3px;
}

.loc-pin-wrap.unlocked-quest .loc-pin-badge {
  border-color: #60a5fa;
  background: #1e3a8a;
  color: #fff;
}

.loc-pin-wrap.completed-quest .loc-pin-badge {
  border-color: #10b981;
  background: #064e3b;
  color: #a7f3d0;
}

.loc-pin-circle {
  width: 34px;
  height: 34px;
  border-radius: 6px;
  background: #1f2937;
  border: 2px solid #6b7280;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 3px 8px rgba(0,0,0,0.75);
}
.loc-pin-wrap.unlocked-quest .loc-pin-circle {
  border-color: #60a5fa;
  background: #2563eb;
}
.loc-pin-wrap.completed-quest .loc-pin-circle {
  border-color: #10b981;
  background: #059669;
}

.landmark-pin-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  opacity: 0.9;
}
.landmark-pin-box {
  width: 28px;
  height: 28px;
  background: rgba(17, 24, 39, 0.92);
  border: 1px solid #6b7280;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.landmark-pin-label {
  background: rgba(17, 24, 39, 0.92);
  color: #d1d5db;
  font-size: 9px;
  padding: 1px 5px;
  border-radius: 3px;
  margin-top: 2px;
  white-space: nowrap;
  border: 1px solid #374151;
}

/* MODALE */
.overlay-modal {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(9, 13, 22, 0.85);
  backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
}
.hidden { display: none !important; }

.clean-window {
  max-width: 820px;
  width: 100%;
  background: #111827;
  border: 1px solid #374151;
  border-radius: 10px;
  padding: 24px;
  box-shadow: 0 20px 50px rgba(0,0,0,0.8);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.start-header {
  display: flex;
  gap: 18px;
  align-items: center;
  border-bottom: 1px solid #1f2937;
  padding-bottom: 14px;
}

.start-title-block h1 {
  font-family: 'JetBrains Mono', monospace;
  font-size: 20px;
  font-weight: 800;
  color: #f9fafb;
  margin-bottom: 4px;
}

.start-features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 10px;
}

.feature-card {
  background: #1f2937;
  border: 1px solid #374151;
  border-radius: 6px;
  padding: 12px;
}
.feature-card h4 { color: #93c5fd; font-size: 13px; margin-bottom: 4px; }
.feature-card p { font-size: 12px; color: #d1d5db; line-height: 1.4; }

.primary-cta-btn {
  background: #2563eb;
  color: #ffffff;
  border: 1px solid #60a5fa;
  border-radius: 6px;
  padding: 13px 20px;
  font-family: 'Inter', sans-serif;
  font-weight: 700;
  font-size: 13px;
  cursor: pointer;
  text-align: center;
  transition: background 0.15s;
}
.primary-cta-btn:hover {
  background: #1d4ed8;
}

/* SCENKA AUTOBUSU A4 — REALISTYCZNA ULICA GLIWIC 1:1 W PIXEL-ARCIE */
.bus-cutscene-window {
  max-width: 800px;
  width: 100%;
  background: #111827;
  border: 1px solid #4b5563;
  border-radius: 10px;
  overflow: hidden;
  box-shadow: 0 25px 70px rgba(0,0,0,0.95);
}

.bus-header {
  background: #1f2937;
  padding: 10px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #374151;
}

.bus-line-badge {
  background: #facc15;
  color: #111827;
  font-family: 'JetBrains Mono', monospace;
  font-weight: 800;
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 4px;
}

.bus-stage {
  position: relative;
  height: 270px;
  background: linear-gradient(180deg, #38bdf8 0%, #93c5fd 52%, #475569 52%, #334155 72%, #1e293b 72%, #0f172a 100%);
  overflow: hidden;
}

.bus-scrolling-buildings {
  position: absolute;
  bottom: 66px;
  left: 0;
  width: 200%;
  height: 195px;
  display: flex;
  animation: scrollGliwiceCity 5.5s linear infinite;
}

@keyframes scrollGliwiceCity {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

.bus-road-stripes {
  position: absolute;
  bottom: 28px;
  left: 0;
  width: 200%;
  height: 4px;
  background: repeating-linear-gradient(90deg, #f8fafc 0px, #f8fafc 45px, transparent 45px, transparent 90px);
  animation: moveRoad 0.3s linear infinite;
}

@keyframes moveRoad {
  from { transform: translateX(0); }
  to { transform: translateX(-90px); }
}

.bus-vehicle-wrap {
  position: absolute;
  bottom: 24px;
  left: 50%;
  transform: translateX(-50%);
  width: 470px;
  height: 140px;
  z-index: 5;
  animation: busBounce 0.28s ease-in-out infinite alternate;
}

@keyframes busBounce {
  0% { transform: translateX(-50%) translateY(0px); }
  100% { transform: translateX(-50%) translateY(-2px); }
}

.bus-footer {
  padding: 12px 18px;
  text-align: left;
  background: #111827;
  border-top: 1px solid #374151;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* ============================================================================
   WNĘTRZA LOKALIZACJI I NOWA KARTA ZADANIA (ZERO KASYNA — CZYSTY PANEL TECHNICZNY)
   ============================================================================ */
.interior-window {
  max-width: 960px;
  width: 100%;
  max-height: 95vh;
  border-radius: 10px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24px 70px rgba(0,0,0,0.9);
  background: #111827;
  border: 1px solid #4b5563;
}

.theme-zsti { --loc-accent: #38bdf8; --loc-surface: #1e293b; }
.theme-forum { --loc-accent: #94a3b8; --loc-surface: #27272a; }
.theme-arena { --loc-accent: #f87171; --loc-surface: #27171c; }
.theme-chrobrego { --loc-accent: #34d399; --loc-surface: #132a20; }
.theme-habib { --loc-accent: #fb923c; --loc-surface: #2a1810; }
.theme-stadium { --loc-accent: #60a5fa; --loc-surface: #112233; }

.interior-top-bar {
  background: #1f2937;
  padding: 10px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #374151;
}

.interior-top-bar h2 {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  font-weight: 700;
  color: var(--loc-accent);
}

.interior-scene-canvas {
  position: relative;
  height: 285px;
  width: 100%;
  overflow: hidden;
  border-bottom: 1px solid #374151;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 16px 52px;
}

.scene-bg-zsti {
  background: linear-gradient(180deg, #0f172a 0%, #1e293b 72%, #334155 72%, #0f172a 100%);
}
.scene-bg-forum {
  background: linear-gradient(180deg, #18181b 0%, #27272a 72%, #3f3f46 72%, #18181b 100%);
}
.scene-bg-arena {
  background: linear-gradient(180deg, #09090b 0%, #1e1b4b 68%, #7f1d1d 68%, #450a0a 100%);
}
.scene-bg-chrobrego {
  background: linear-gradient(180deg, #0ea5e9 0%, #bae6fd 65%, #15803d 65%, #166534 100%);
}
.scene-bg-habib {
  background: linear-gradient(180deg, #271209 0%, #431407 72%, #292524 72%, #1c1917 100%);
}
.scene-bg-stadium {
  background: repeating-linear-gradient(0deg, #15803d 0px, #15803d 24px, #166534 24px, #166534 48px);
}

.interior-prop-banner {
  position: absolute;
  top: 10px;
  left: 16px;
  background: rgba(17, 24, 39, 0.9);
  border: 1px solid #4b5563;
  padding: 4px 10px;
  border-radius: 4px;
  font-family: 'JetBrains Mono', monospace;
  font-weight: 700;
  font-size: 10px;
  color: #e5e7eb;
  z-index: 3;
}

.character-stage-card {
  position: relative;
  z-index: 5;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.char-name-plate {
  background: rgba(17, 24, 39, 0.95);
  border: 1px solid #4b5563;
  padding: 3px 10px;
  border-radius: 4px;
  font-size: 11px;
  font-weight: 600;
  color: #f3f4f6;
  margin-top: 4px;
}

/* DYMKI CZATU WYCHODZĄCE Z UST POSTACI */
.mouth-speech-bubble {
  position: absolute;
  top: 6px;
  width: 290px;
  background: #ffffff;
  color: #111827;
  border: 2px solid #111827;
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
  z-index: 30;
  box-shadow: 0 8px 20px rgba(0,0,0,0.5);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mouth-speech-bubble.from-left-mouth { left: 95px; }
.mouth-speech-bubble.from-left-mouth::before {
  content: '';
  position: absolute;
  top: 26px;
  left: -12px;
  border-width: 7px 12px 7px 0;
  border-style: solid;
  border-color: transparent #111827 transparent transparent;
}
.mouth-speech-bubble.from-left-mouth::after {
  content: '';
  position: absolute;
  top: 28px;
  left: -9px;
  border-width: 5px 10px 5px 0;
  border-style: solid;
  border-color: transparent #ffffff transparent transparent;
}

.mouth-speech-bubble.from-right-mouth { right: 95px; }
.mouth-speech-bubble.from-right-mouth::before {
  content: '';
  position: absolute;
  top: 26px;
  right: -12px;
  border-width: 7px 0 7px 12px;
  border-style: solid;
  border-color: transparent transparent transparent #111827;
}
.mouth-speech-bubble.from-right-mouth::after {
  content: '';
  position: absolute;
  top: 28px;
  right: -9px;
  border-width: 5px 0 5px 10px;
  border-style: solid;
  border-color: transparent transparent transparent #ffffff;
}

.bubble-footer-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1px solid #e5e7eb;
  padding-top: 6px;
}

.bubble-step-counter {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: #6b7280;
}

.bubble-next-btn {
  pointer-events: auto;
  background: #2563eb;
  color: #fff;
  border: none;
  border-radius: 4px;
  padding: 4px 10px;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
}

.mouth-open { display: none; }
.mouth-closed { display: block; }
.is-talking .mouth-open {
  display: block;
  animation: mouthTalkOpen 0.2s steps(2, start) infinite;
}
.is-talking .mouth-closed {
  animation: mouthTalkClosed 0.2s steps(2, start) infinite;
}
@keyframes mouthTalkOpen { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
@keyframes mouthTalkClosed { 0%, 49% { opacity: 0; } 50%, 100% { opacity: 1; } }

/* ANIMACJE BOKSERSKIE */
@keyframes animJabRight {
  0% { transform: translateX(0); }
  45% { transform: translateX(135px) rotate(5deg); }
  100% { transform: translateX(0); }
}
@keyframes animHookRight {
  0% { transform: translateX(0); }
  30% { transform: translateX(-16px) rotate(-8deg); }
  60% { transform: translateX(160px) translateY(-10px) rotate(14deg) scale(1.12); }
  100% { transform: translateX(0); }
}
@keyframes animUppercutRight {
  0% { transform: translateY(0); }
  35% { transform: translateY(14px); }
  65% { transform: translateX(140px) translateY(-25px) rotate(-10deg) scale(1.12); }
  100% { transform: translateY(0); }
}
@keyframes animEnemyAttackLeft {
  0% { transform: translateX(0); }
  50% { transform: translateX(-140px) rotate(-10deg) scale(1.1); }
  100% { transform: translateX(0); }
}
@keyframes animHitShake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10px) rotate(-5deg); filter: brightness(1.7); }
